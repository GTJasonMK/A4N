{
  "schema_version": 2,
  "suites": {
    "rust-format": {
      "command": ["cargo", "fmt", "--all", "--", "--check"],
      "timeout_seconds": 300
    },
    "rust-contract": {
      "command": ["bash", "scripts/checks/check-generation-contracts.sh"],
      "timeout_seconds": 300
    },
    "rust-safety-boundary": {
      "command": ["bash", "scripts/checks/check-generation-safety-boundary.sh"],
      "timeout_seconds": 300
    },
    "rust-service-protocol": {
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "a4n-service-protocol",
        "--lib",
        "events_artifacts"
      ],
      "timeout_seconds": 900
    },
    "python-tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 900
    },
    "python-checks": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/checks",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 300
    },
    "test-catalog": {
      "command": ["python3", "scripts/tests/check_test_catalog.py"],
      "timeout_seconds": 60
    },
    "frontend-unit": {
      "command": ["npm", "--prefix", "frontend", "run", "test:run"],
      "timeout_seconds": 900
    },
    "frontend-browser-helpers": {
      "command": ["npm", "--prefix", "frontend", "run", "test:browser-helpers"],
      "timeout_seconds": 300
    },
    "frontend-build": {
      "command": ["npm", "--prefix", "frontend", "run", "build"],
      "timeout_seconds": 900
    },
    "frontend-parity": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "check:web-api-parity"
      ],
      "timeout_seconds": 900
    },
    "affected-rust-integration": {
      "command": [
        "python3",
        "scripts/tests/run_affected_rust_tests.py"
      ],
      "timeout_seconds": 7800
    },
    "browser-llm-cache": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-llm-cache"
      ],
      "timeout_seconds": 300
    },
    "browser-llm-presets": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-llm-presets"
      ],
      "timeout_seconds": 300
    },
    "browser-video-mode": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-video-mode"
      ],
      "timeout_seconds": 300
    },
    "browser-video-scrub": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-video-scrub"
      ],
      "timeout_seconds": 600
    },
    "browser-ui-presentation": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-ui-presentation"
      ],
      "timeout_seconds": 900
    },
    "browser-ui-functional": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-ui-functional"
      ],
      "timeout_seconds": 1800
    },
    "browser-director-timeline": {
      "command": ["node", "frontend/e2e/director-timeline/check.mjs"],
      "timeout_seconds": 900
    },
    "browser-fact-feedback": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-fact-feedback"
      ],
      "timeout_seconds": 600
    },
    "rust-workspace": {
      "command": [
        "python3",
        "scripts/tests/run_with_test_database.py",
        "--timeout",
        "7200",
        "--",
        "bash",
        "-c",
        "set -euo pipefail; cargo run --locked -p a4n-migration; exec cargo test --locked --workspace --all-targets --no-fail-fast -- --test-threads=1"
      ],
      "timeout_seconds": 7800
    },
    "browser-canvas": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-canvas-starter"
      ],
      "timeout_seconds": 600
    },
    "creation-e2e": {
      "command": [
        "python3",
        "scripts/tests/run_creation_e2e.py",
        "--report-dir",
        "{report_dir}/creation-e2e",
        "--stage",
        "all",
        "--browser-feature-flows"
      ],
      "timeout_seconds": 14100
    },
    "tauri-functional": {
      "command": [
        "python3",
        "scripts/tests/run_tauri_generation_e2e.py",
        "--report-dir",
        "{report_dir}/tauri-functional"
      ],
      "timeout_seconds": 1200
    },
    "core-boundaries": {
      "command": ["bash", "scripts/checks/check-core-boundary.sh"],
      "timeout_seconds": 1800
    },
    "worker-isolation": {
      "command": ["bash", "scripts/checks/check-worker-isolation.sh"],
      "timeout_seconds": 1800
    }
  },
  "test_center": {
    "functional_suites": [
      "rust-service-protocol",
      "python-tests",
      "frontend-unit",
      "frontend-browser-helpers",
      "affected-rust-integration",
      "browser-llm-cache",
      "browser-llm-presets",
      "browser-video-mode",
      "browser-video-scrub",
      "browser-ui-functional",
      "browser-director-timeline",
      "browser-fact-feedback",
      "browser-canvas",
      "rust-workspace",
      "creation-e2e",
      "tauri-functional"
    ],
    "groups": [
      {
        "id": "core-functional",
        "category": "核心功能",
        "title": "核心单元与集成测试",
        "description": "运行 Rust、Python 和前端功能测试，以及 Rust workspace 集成测试。",
        "suites": [
          "rust-service-protocol",
          "python-tests",
          "frontend-unit",
          "frontend-browser-helpers",
          "affected-rust-integration",
          "rust-workspace"
        ]
      },
      {
        "id": "browser-functional",
        "category": "浏览器功能",
        "title": "浏览器功能流程",
        "description": "运行模型配置、缓存、视频、Canvas、页面交互和事实反馈流程。",
        "suites": [
          "browser-llm-cache",
          "browser-llm-presets",
          "browser-video-mode",
          "browser-video-scrub",
          "browser-ui-functional",
          "browser-director-timeline",
          "browser-fact-feedback",
          "browser-canvas"
        ]
      },
      {
        "id": "authoring-workflows",
        "category": "完整流程",
        "title": "创作端到端流程",
        "description": "运行完整创作阶段和浏览器功能流程端到端测试。",
        "suites": ["creation-e2e"]
      },
      {
        "id": "desktop-workflows",
        "category": "桌面功能",
        "title": "Tauri 桌面流程",
        "description": "运行 Tauri Native 创建项目、生成和结果恢复流程。需要启动环境提供已构建的 A4N_WDIO_APP_BINARY、隔离数据库、Qdrant 和 JWT 配置。",
        "suites": ["tauri-functional"]
      },
      {
        "id": "all-functional",
        "category": "全部功能",
        "title": "全部功能测试",
        "description": "按顺序运行项目当前登记的全部功能测试 suite。",
        "suites": [
          "rust-service-protocol",
          "python-tests",
          "frontend-unit",
          "frontend-browser-helpers",
          "affected-rust-integration",
          "browser-llm-cache",
          "browser-llm-presets",
          "browser-video-mode",
          "browser-video-scrub",
          "browser-ui-functional",
          "browser-director-timeline",
          "browser-fact-feedback",
          "browser-canvas",
          "rust-workspace",
          "creation-e2e",
          "tauri-functional"
        ]
      }
    ]
  },
  "profiles": {
    "fast": {
      "suites": [
        "rust-format",
        "rust-contract",
        "rust-safety-boundary",
        "rust-service-protocol",
        "affected-rust-integration",
        "python-tests",
        "python-checks",
        "test-catalog",
        "frontend-unit",
        "frontend-browser-helpers",
        "frontend-build",
        "frontend-parity",
        "browser-llm-cache",
        "browser-llm-presets",
        "browser-video-mode",
        "browser-video-scrub",
        "browser-ui-presentation"
      ]
    },
    "nightly": {
      "extends": "fast",
      "exclude": ["affected-rust-integration", "rust-service-protocol"],
      "suites": [
        "browser-canvas",
        "browser-ui-functional",
        "browser-fact-feedback",
        "rust-workspace",
        "creation-e2e"
      ]
    },
    "nightly-quick": {
      "extends": "nightly",
      "exclude": ["rust-workspace", "creation-e2e"]
    },
    "tauri-functional": {
      "suites": ["tauri-functional"]
    },
    "full": {
      "extends": "nightly",
      "suites": ["core-boundaries", "worker-isolation"]
    }
  }
}
