{
  "schema_version": 2,
  "suites": {
    "rust-format": {
      "command": ["cargo", "fmt", "--all", "--", "--check"],
      "timeout_seconds": 300
    },
    "rust-contract": {
      "command": ["bash", "scripts/checks/check-generation-contracts.sh"],
      "timeout_seconds": 300
    },
    "rust-safety-boundary": {
      "command": ["bash", "scripts/checks/check-generation-safety-boundary.sh"],
      "timeout_seconds": 300
    },
    "rust-service-protocol": {
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "a4n-service-protocol",
        "--lib",
        "events_artifacts"
      ],
      "timeout_seconds": 900
    },
    "python-tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 900
    },
    "python-checks": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/checks",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 300
    },
    "test-catalog": {
      "command": ["python3", "scripts/tests/check_test_catalog.py"],
      "timeout_seconds": 60
    },
    "frontend-unit": {
      "command": ["npm", "--prefix", "frontend", "run", "test:run"],
      "timeout_seconds": 900
    },
    "frontend-browser-helpers": {
      "command": ["npm", "--prefix", "frontend", "run", "test:browser-helpers"],
      "timeout_seconds": 300
    },
    "frontend-build": {
      "command": ["npm", "--prefix", "frontend", "run", "build"],
      "timeout_seconds": 900
    },
    "frontend-parity": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "check:web-api-parity"
      ],
      "timeout_seconds": 900
    },
    "affected-rust-integration": {
      "command": [
        "python3",
        "scripts/tests/run_affected_rust_tests.py"
      ],
      "timeout_seconds": 7800
    },
    "browser-llm-cache": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-llm-cache"
      ],
      "timeout_seconds": 300
    },
    "browser-llm-presets": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-llm-presets"
      ],
      "timeout_seconds": 300
    },
    "browser-video-mode": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-video-mode"
      ],
      "timeout_seconds": 300
    },
    "browser-video-scrub": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-video-scrub"
      ],
      "timeout_seconds": 600
    },
    "browser-ui-presentation": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-ui-presentation"
      ],
      "timeout_seconds": 900
    },
    "browser-ui-functional": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-ui-functional"
      ],
      "timeout_seconds": 1800
    },
    "browser-fact-feedback": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-fact-feedback"
      ],
      "timeout_seconds": 600
    },
    "rust-workspace": {
      "command": [
        "python3",
        "scripts/tests/run_with_test_database.py",
        "--timeout",
        "7200",
        "--",
        "bash",
        "-c",
        "set -euo pipefail; cargo run --locked -p a4n-migration; exec cargo test --locked --workspace --all-targets --no-fail-fast -- --test-threads=1"
      ],
      "timeout_seconds": 7800
    },
    "browser-canvas": {
      "command": [
        "npm",
        "--prefix",
        "frontend",
        "run",
        "test:browser-canvas-starter"
      ],
      "timeout_seconds": 600
    },
    "creation-e2e": {
      "command": [
        "python3",
        "scripts/tests/run_creation_e2e.py",
        "--stage",
        "all",
        "--browser-feature-flows"
      ],
      "timeout_seconds": 14100
    },
    "tauri-functional": {
      "command": ["python3", "scripts/tests/run_tauri_generation_e2e.py"],
      "timeout_seconds": 1200
    },
    "core-boundaries": {
      "command": ["bash", "scripts/checks/check-core-boundary.sh"],
      "timeout_seconds": 1800
    },
    "worker-isolation": {
      "command": ["bash", "scripts/checks/check-worker-isolation.sh"],
      "timeout_seconds": 1800
    }
  },
  "profiles": {
    "fast": {
      "suites": [
        "rust-format",
        "rust-contract",
        "rust-safety-boundary",
        "rust-service-protocol",
        "affected-rust-integration",
        "python-tests",
        "python-checks",
        "test-catalog",
        "frontend-unit",
        "frontend-browser-helpers",
        "frontend-build",
        "frontend-parity",
        "browser-llm-cache",
        "browser-llm-presets",
        "browser-video-mode",
        "browser-video-scrub",
        "browser-ui-presentation"
      ]
    },
    "nightly": {
      "extends": "fast",
      "exclude": ["affected-rust-integration", "rust-service-protocol"],
      "suites": [
        "browser-canvas",
        "browser-ui-functional",
        "browser-fact-feedback",
        "rust-workspace",
        "creation-e2e"
      ]
    },
    "nightly-quick": {
      "extends": "nightly",
      "exclude": ["rust-workspace", "creation-e2e"]
    },
    "tauri-functional": {
      "suites": ["tauri-functional"]
    },
    "full": {
      "extends": "nightly",
      "suites": ["core-boundaries", "worker-isolation"]
    }
  }
}
