# Copy this file to <worktree>/.deploy.env and fill in the local deployment target.
# .deploy.env is ignored; never commit private key contents or application secrets.
A4N_DEPLOY_HOST=
A4N_DEPLOY_USER=ubuntu
A4N_DEPLOY_SSH_KEY=
A4N_DEPLOY_PUBLIC_ORIGIN=
A4N_DEPLOY_BASE_PATH=/a4n
A4N_DEPLOY_API_BASE_URL=/a4n/api
A4N_DEPLOY_ROOT_EXPECTED_STATUS=200
A4N_DEPLOY_CARGO_OFFLINE=true
