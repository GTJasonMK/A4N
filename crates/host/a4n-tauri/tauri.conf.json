{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "A4N",
  "identifier": "com.a4n.app",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "A4N - Agents for Narrative",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "backgroundColor": "#1c1714",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRUQ0MkJCNEFDNTkyRUMKUldUc2tzVkt1MEx0a0VsQVJmUnZtQ2M1TThTTngxT1I0eVBKdlo1SzVJbENqQXF6VFdvRk5rNU8K",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/GTJasonMK/A4N/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
