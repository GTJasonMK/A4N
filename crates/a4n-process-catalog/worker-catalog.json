[
  {
    "name": "agent-worker",
    "kind": "stateful_worker",
    "binary": "a4n-agent-worker",
    "contract_version": "worker-schema-v6",
    "capability_version": "agent-worker-v1",
    "addr_env": "A4N_AGENT_WORKER_ADDR",
    "url_env": "A4N_AGENT_WORKER_URL",
    "default_addr": "127.0.0.1:47650",
    "local_only": true,
    "data_scope": [
      "agent_thread",
      "agent_message",
      "agent_turn",
      "agent_run",
      "agent_execution",
      "agent_event",
      "agent_inbox",
      "agent_delegation",
      "agent_approval",
      "agent_memory"
    ],
    "capabilities": [
      "agent.run",
      "agent.host_command",
      "agent.thread.ensure_main",
      "agent.thread.create",
      "agent.thread.fork",
      "agent.thread.update",
      "agent.thread.archive",
      "agent.thread.list",
      "agent.thread.show",
      "agent.thread.messages",
      "agent.run.show",
      "agent.event.list",
      "agent.memory.list",
      "agent.memory.create",
      "agent.memory.retract",
      "agent.approval.resolve",
      "agent.delegation.spawn",
      "agent.delegation.review"
    ],
    "dependencies": [
      "a4n-control",
      "a4n-migration"
    ],
    "migration": {
      "current": "agent_runtime",
      "min_compatible": "agent_runtime",
      "max_compatible": "agent_runtime"
    }
  },
  {
    "name": "novel-planning-worker",
    "kind": "stateful_worker",
    "binary": "a4n-novel-planning-worker",
    "contract_version": "novel-planning-shooting-script-v1",
    "capability_version": "novel-planning-shooting-script-v1",
    "addr_env": "A4N_NOVEL_PLANNING_WORKER_ADDR",
    "url_env": "A4N_NOVEL_PLANNING_WORKER_URL",
    "default_addr": "127.0.0.1:47651",
    "local_only": true,
    "data_scope": [
      "chapter_shooting_script",
      "chapter_visual_plan",
      "cleanup_outbox"
    ],
    "capabilities": [
      "shooting_script.current",
      "shooting_script.unit_progress",
      "shooting_script.edit",
      "shooting_script.delete",
      "shooting_script.publish",
      "visual_plan.persistence"
    ],
    "dependencies": [
      "a4n-migration"
    ],
    "migration": {
      "current": "shooting_script",
      "min_compatible": "shooting_script",
      "max_compatible": "shooting_script"
    }
  },
  {
    "name": "artifact-media-worker",
    "kind": "stateful_worker",
    "binary": "a4n-artifact-media-worker",
    "contract_version": "artifact-media-v1",
    "capability_version": "artifact-media-v1",
    "addr_env": "A4N_ARTIFACT_MEDIA_WORKER_ADDR",
    "url_env": "A4N_ARTIFACT_MEDIA_WORKER_URL",
    "default_addr": "127.0.0.1:47652",
    "local_only": true,
    "data_scope": [
      "image_publication",
      "cleanup_outbox",
      "media_artifact"
    ],
    "capabilities": ["artifact-media"],
    "dependencies": ["a4n-migration"],
    "migration": {
      "current": "image_publication",
      "min_compatible": "image_publication",
      "max_compatible": "image_publication"
    }
  }
]
