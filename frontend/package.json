{
  "name": "a4n-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "generate:api-contract": "cargo run --manifest-path ../Cargo.toml -q -p a4n-api-contract --bin generate_types -- --write",
    "check:api-contract": "cargo run --manifest-path ../Cargo.toml -q -p a4n-api-contract --bin generate_types -- --check",
    "generate:generation-contract": "bash ../scripts/contracts/generate-generation-contracts.sh --write",
    "check:generation-contract": "bash ../scripts/checks/check-generation-contracts.sh",
    "check:web-api-parity": "npm run check:api-contract && npm run check:generation-contract",
    "test:browser-video-mode": "wdio run ./e2e/video-mode-switch/wdio.conf.mjs",
    "test:browser-video-scrub": "wdio run ./e2e/video-scrub/wdio.conf.mjs",
    "test:browser-ui-presentation": "wdio run ./e2e/ui-presentation/wdio.conf.mjs",
    "test:browser-full-project": "wdio run ./e2e/full-project/wdio.conf.mjs",
    "test:browser-package-lifecycle": "wdio run ./e2e/full-project/wdio.conf.mjs --spec ./e2e/package-lifecycle/package-lifecycle.e2e.mjs",
    "test:tauri-generation": "wdio run ./e2e/tauri-generation/wdio.conf.mjs",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "^12.11.1",
    "ajv": "^8.20.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/cli": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/tauri-service": "1.2.0",
    "json-schema-to-typescript": "15.0.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
