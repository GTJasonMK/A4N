#!/usr/bin/env bash
set -euo pipefail
if [[ "$(git branch --show-current)" == master ]]; then
    hook_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    candidate_tree="$(git write-tree)"
    python3 "$hook_dir/../scripts/tests/verify_model_report.py" --candidate-tree "$candidate_tree"
fi
