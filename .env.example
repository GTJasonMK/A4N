# Copy this file to .env for local development and keep real values out of Git.
# The application can also be configured from the in-app settings UI.

# Required runtime secrets and database
# A4N_DATABASE_URL=postgres://a4n:a4n@127.0.0.1:5432/a4n
# A4N_JWT_SECRET=replace-with-a-long-random-secret

# Runtime storage paths
# A4N_DATA_DIR=data
# A4N_CACHE_DIR=data/cache
# A4N_TEMP_DIR=data/tmp
# A4N_LOG_DIR=data/logs

# RAG 索引（Qdrant，替代原 data/lance + data/tantivy）
# 项目内 release：./scripts/dev/setup-qdrant.sh && ./scripts/dev/run-qdrant.sh
# 或：docker compose up -d qdrant
# A4N_QDRANT_URL=http://127.0.0.1:6334
# A4N_QDRANT_API_KEY=
# A4N_QDRANT_COLLECTION=a4n_rag
# 逻辑 collection 名仍为 project_id 字符串；物理 collection 为上者
# A4N_RAG_SERVICE_DATA_DIR=data
# A4N_RAG_SERVICE_ADDR=127.0.0.1:47644
# A4N_RAG_SERVICE_URL=http://127.0.0.1:47644

# ONNX Runtime 1.24.2 shared installation. The default is
# ~/.local/share/a4n/onnxruntime/1.24.2; install it with:
# ./scripts/dev/setup-onnxruntime.sh
# A4N_ONNXRUNTIME_ROOT=/absolute/path/to/onnxruntime/1.24.2

# Web server
# A4N_WEB_ADDR=127.0.0.1:8080
# A4N_FRONTEND_DIST=frontend/dist
# A4N_BOOTSTRAP_ADMIN_USERNAME=admin
# A4N_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# A4N_BOOTSTRAP_ADMIN_PASSWORD=replace-with-an-initial-admin-password

# Migration CLI
# DATABASE_URL=postgres://a4n:a4n@127.0.0.1:5432/a4n

# Rust tests that touch the database require an explicit PostgreSQL test DB.
# A4N_TEST_DATABASE_URL=postgres://a4n:a4n@127.0.0.1:5432/a4n_test

# Optional OpenAI-compatible defaults
# A4N_OPENAI_API_KEY=
# A4N_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional public model defaults seeded into an empty server database.
# These configs are stored server-side and are used by all users unless they set local overrides.
# LLM can also use A4N_OPENAI_API_KEY as the key source.
# A4N_PUBLIC_LLM_NAME=公共基础 LLM
# A4N_PUBLIC_LLM_PROVIDER=deepseek
# A4N_PUBLIC_LLM_BASE_URL=https://api.deepseek.com/v1
# A4N_PUBLIC_LLM_API_KEY=
# A4N_PUBLIC_LLM_MODEL=deepseek-v4-flash
# A4N_PUBLIC_LLM_MAX_CONCURRENT=3
# A4N_PUBLIC_LLM_TIMEOUT_SECS=300
# Provider-specific extra JSON fields merged into /chat/completions requests.
# Reserved system fields such as model/messages/stream/max_tokens are rejected.
# A4N_PUBLIC_LLM_EXTRA_BODY_JSON={"reasoning_effort":"low"}

# Image can also use A4N_OPENAI_API_KEY / A4N_OPENAI_BASE_URL as the key/base URL source.
# A4N_PUBLIC_IMAGE_NAME=公共基础图片
# A4N_PUBLIC_IMAGE_BACKEND=openai-compatible-image
# CLIProxy Grok image example: A4N_PUBLIC_IMAGE_BACKEND=cliproxy-image
# A4N_PUBLIC_IMAGE_BASE_URL=https://api.openai.com/v1
# A4N_PUBLIC_IMAGE_API_KEY=
# A4N_PUBLIC_IMAGE_MODEL=dall-e-3
# A4N_PUBLIC_IMAGE_MAX_CONCURRENT=2
# A4N_PUBLIC_IMAGE_DEFAULT_WIDTH=1024
# A4N_PUBLIC_IMAGE_DEFAULT_HEIGHT=1024

# Video must be configured explicitly because providers and duration capabilities differ.
# A4N_PUBLIC_VIDEO_NAME=公共基础视频
# A4N_PUBLIC_VIDEO_BACKEND=openai-compatible-video
# CLIProxy Grok video example: A4N_PUBLIC_VIDEO_BACKEND=cliproxy-openai-video
# A4N_PUBLIC_VIDEO_BASE_URL=https://example.com/v1
# A4N_PUBLIC_VIDEO_API_KEY=
# A4N_PUBLIC_VIDEO_MODEL=video-model
# A4N_PUBLIC_VIDEO_MAX_CONCURRENT=1
# A4N_PUBLIC_VIDEO_DEFAULT_WIDTH=1280
# A4N_PUBLIC_VIDEO_DEFAULT_HEIGHT=720
# A4N_PUBLIC_VIDEO_DEFAULT_DURATION_SECS=5
# A4N_PUBLIC_VIDEO_MIN_DURATION_SECS=1
# A4N_PUBLIC_VIDEO_MAX_DURATION_SECS=60
# A4N_PUBLIC_VIDEO_DURATION_MODE=range
# A4N_PUBLIC_VIDEO_SUPPORTED_DURATIONS_JSON=[5,10]
# A4N_PUBLIC_VIDEO_DEFAULT_FPS=24
# 章节和 Canvas 的视频图片输入默认用本地 data URL；也可显式选择公网 URL 或远端临时上传。
# remote_temp_upload 会先把首帧/尾帧/参考图上传到远端 A4N 临时媒体接口，再把返回 URL 发给视频模型。
# 若第三方视频 provider 明确只接受可公网访问 URL，也可改为 public_url 并设置 A4N_PUBLIC_APP_URL 或 A4N_PUBLIC_MEDIA_BASE_URL。
# A4N_VIDEO_IMAGE_INPUT_TRANSPORT=auto
# A4N_VIDEO_MEDIA_TOKEN_TTL_MINUTES=360
# A4N_VIDEO_REMOTE_TEMP_UPLOAD_URL=https://app.example.com/a4n/api/temp-media
# A4N_VIDEO_REMOTE_TEMP_UPLOAD_TOKEN=replace-with-the-server-temp-media-token

# Server-side temporary media relay. Used by local runtimes with A4N_VIDEO_IMAGE_INPUT_TRANSPORT=remote_temp_upload.
# A4N_TEMP_MEDIA_UPLOAD_TOKEN=replace-with-a-long-random-secret
# A4N_TEMP_MEDIA_TTL_MINUTES=360
# A4N_TEMP_MEDIA_MAX_BYTES=20971520
# A4N_TEMP_MEDIA_PUBLIC_BASE_URL=https://app.example.com/a4n/api/temp-media

# Local ComfyUI bridge for cloud LTX 2.3 / Z-Image.
# Do not put the SSH password here; SSH will prompt for it or use your SSH agent/key.
# A4N image/video providers can point to http://127.0.0.1:8787/v1 with API key ltx-local.
# LTX_SSH_HOST=gpu.example.com
# LTX_SSH_PORT=22
# LTX_SSH_USER=root
# LTX_LOCAL_COMFY_PORT=6006
# LTX_REMOTE_COMFY_HOST=127.0.0.1
# LTX_REMOTE_COMFY_PORT=6006
# LTX_REMOTE_COMFY_ROOT=/root/ComfyUI
# LTX_REMOTE_PYTHON_BIN=/root/miniconda3/bin/python
# LTX_REMOTE_COMFY_LOG=/tmp/comfyui-start.log
# LTX_REMOTE_HF_ENDPOINT=https://hf-mirror.com
# LTX_REMOTE_HF_HOME=/root/autodl-tmp/huggingface
# LTX_REMOTE_HF_HUB_CACHE=/root/autodl-tmp/huggingface/hub
# LTX_REMOTE_HF_XET_CACHE=/root/autodl-tmp/huggingface/xet
# LTX_REMOTE_HF_HUB_DISABLE_XET=0
# LTX_REMOTE_HF_HUB_DOWNLOAD_TIMEOUT=60
# LTX_REMOTE_HF_XET_NUM_CONCURRENT_RANGE_GETS=8
# LTX_REMOTE_HTTP_PROXY=http://127.0.0.1:7890
# LTX_REMOTE_HTTPS_PROXY=http://127.0.0.1:7890
# LTX_REMOTE_ALL_PROXY=socks5h://127.0.0.1:7890
# LTX_REMOTE_NO_PROXY=127.0.0.1,localhost
# LTX_BRIDGE_HOST=127.0.0.1
# LTX_BRIDGE_PORT=8787
# LTX_BRIDGE_API_KEY=ltx-local
# LTX_BRIDGE_CONFIG=data/ltx-bridge.config.json
# LTX_COMFY_BASE_URL=http://127.0.0.1:6006
# LTX_PROGRESS_LOG_INTERVAL_MS=5000
# LTX_GPU_LOG_INTERVAL_MS=15000
# LTX_CHECKPOINT_NAME=ltx-2.3-22b-dev-fp8.safetensors
# LTX_LORA_NAME=Ltx/ltx-2.3-22b-distilled-lora-384-1.1.safetensors
# LTX_UPSCALER_NAME=ltx-2.3-spatial-upscaler-x2-1.1.safetensors
# LTX_TEXT_ENCODER_NAME=gemma_3_12B_it_fp4_mixed.safetensors
# ZIMAGE_MODEL_NAME=nunchaku/svdq-fp4_r128-z-image-turbo.safetensors
# ZIMAGE_TEXT_ENCODER_NAME=qwen_3_4b.safetensors
# ZIMAGE_VAE_NAME=ae.safetensors
# ZIMAGE_CONTROLNET_PATCH_NAME=Z-Image-Turbo-Fun-Controlnet-Union.safetensors
# LTX_SKIP_REMOTE_START=0
# LTX_SKIP_TUNNEL=0
# LTX_OBJECT_INFO_TIMEOUT_SECS=90
# LTX_SKIP_MODEL_CHECK=0
# LTX_SKIP_NODE_CHECK=0
# LTX_KEEP_TUNNEL=0
# LTX_REMOTE_START_TIMEOUT_SECS=180

# Optional: seed a local A4N install with bridge-backed public providers.
# A4N_PUBLIC_IMAGE_NAME="本地 Z-Image Turbo"
# A4N_PUBLIC_IMAGE_BACKEND=openai-compatible-image
# A4N_PUBLIC_IMAGE_BASE_URL=http://127.0.0.1:8787/v1
# A4N_PUBLIC_IMAGE_API_KEY=ltx-local
# A4N_PUBLIC_IMAGE_MODEL=z-image-turbo
# A4N_PUBLIC_IMAGE_MAX_CONCURRENT=1
# A4N_PUBLIC_IMAGE_DEFAULT_WIDTH=1024
# A4N_PUBLIC_IMAGE_DEFAULT_HEIGHT=1024
# A4N_PUBLIC_VIDEO_NAME="本地 LTX 2.3"
# A4N_PUBLIC_VIDEO_BACKEND=openai-compatible-video
# A4N_PUBLIC_VIDEO_BASE_URL=http://127.0.0.1:8787/v1
# A4N_PUBLIC_VIDEO_API_KEY=ltx-local
# A4N_PUBLIC_VIDEO_MODEL=ltx-2.3
# A4N_PUBLIC_VIDEO_MAX_CONCURRENT=1
# A4N_PUBLIC_VIDEO_DEFAULT_WIDTH=1280
# A4N_PUBLIC_VIDEO_DEFAULT_HEIGHT=720
# A4N_PUBLIC_VIDEO_DEFAULT_DURATION_SECS=5
# A4N_PUBLIC_VIDEO_MIN_DURATION_SECS=1
# A4N_PUBLIC_VIDEO_MAX_DURATION_SECS=60
# A4N_PUBLIC_VIDEO_DURATION_MODE=range
# A4N_PUBLIC_VIDEO_SUPPORTED_DURATIONS_JSON=[5,10]
# A4N_PUBLIC_VIDEO_DEFAULT_FPS=24

# Optional OAuth2 login providers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Logging
# RUST_LOG=info

# Frontend Web runtime. Same-origin deployment can leave this unset.
# VITE_A4N_API_BASE_URL=/api

# Optional cloud deployment helper. Host, SSH key, and public origin are required.
# Add the server host key to ~/.ssh/known_hosts before deploying.
# A4N_DEPLOY_HOST=server.example.com
# A4N_DEPLOY_USER=ubuntu
# A4N_DEPLOY_SSH_KEY=/absolute/path/to/a4n-deploy-key
# A4N_DEPLOY_PUBLIC_ORIGIN=https://app.example.com
# A4N_DEPLOY_STRICT_HOST_KEY_CHECKING=yes

# Local Tauri shell connected to a remote A4N backend.
# Prefer `./scripts/run.sh --remote-api`; these variables are available for manual runs.
# A4N_REMOTE_API_URL=https://app.example.com/a4n/api
# A4N_REMOTE_API_ONLY=1
# VITE_A4N_API_TRANSPORT=web
# VITE_A4N_API_BASE_URL=https://app.example.com/a4n/api
