.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx

# Logs and process state
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
.vite-pid
.vite-port
.cargo-watch-pid

# Generated media and packaged artifacts
*.mp4
*.webm
*.mov
*.m4v
*.avi
*.mkv
*.zip
*.tar.gz
/deploy/

# 参考用上游克隆，禁止作为 workspace 成员参与 monorepo 编译
/crates/qdrant/

# Qdrant 官方 release 二进制与本地索引数据（用 scripts/dev/setup-qdrant.sh 安装）
/tools/qdrant/bin/
/tools/qdrant/storage/
