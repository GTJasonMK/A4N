# Dependencies
frontend/node_modules/

# Build outputs and caches
target/
/target-*/
frontend/dist/
frontend/.vite/
frontend/.tauri/
frontend/src-tauri/target/
__pycache__/
*.py[cod]

# Local runtime data
data/
.dev-runtime/
*.db
*.sqlite
*.sqlite3

